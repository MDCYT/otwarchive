<div class="support-home wrapper" style="max-width:1050px; margin:0 auto; padding:0.5em 1em 2em; box-sizing:border-box; overflow-x:hidden;">
  <h2 class="heading"><%= t("support.home.page_title") %></h2>

  <ul class="navigation actions" role="navigation" style="margin-bottom:1.5em;">
    <li><%= link_to t("support.home.nav.submit_request"), new_ticket_path %></li>
    <li><%= link_to t("support.home.nav.my_requests", count: @open_tickets_count), tickets_path %></li>
    <li><%= link_to t("support.home.nav.faqs"), archive_faqs_path %></li>
    <li><%= link_to t("support.home.nav.back_to_archive"), "https://libreria.org.pe" %></li>
  </ul>

  <div class="module" style="background:#fff; border:1px solid #ddd; padding:2em 1.5em; margin:1.5em 0; text-align:center; border-radius:4px; box-sizing:border-box;">
    <h3 class="heading" style="font-size:1.6em; margin-bottom:0.4em; color:#900;"><%= t("support.home.hero.heading") %></h3>
    <p style="font-size:1.05em; color:#555; max-width:620px; margin:0 auto 1.5em; line-height:1.5;">
      <%= t("support.home.hero.intro", app_name: ArchiveConfig.APP_NAME) %>
    </p>

    <%= form_tag archive_faqs_path, method: :get, class: "search", style: "display:inline-block; width:100%; max-width:540px; box-sizing:border-box;" do %>
      <div style="display:flex; gap:8px; width:100%;">
        <%= text_field_tag :query, params[:query], placeholder: t("support.home.hero.search_placeholder"), style: "flex:1; padding:8px 12px; font-size:1em; border:1px solid #bbb; border-radius:3px; box-sizing:border-box;" %>
        <%= submit_tag t("support.home.hero.search_button"), class: "button", style: "padding:8px 18px; font-size:1em;" %>
      </div>
    <% end %>
  </div>

  <h3 class="landmark heading"><%= t("support.home.categories.landmark") %></h3>
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap:1.2em; margin-bottom:2em;">
    <!-- 1. Accounts -->
    <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box;">
      <div>
        <h4 class="heading" style="color:#900; margin-top:0;"><%= t("support.home.categories.account.title") %></h4>
        <p style="font-size:0.95em; color:#444; line-height:1.45; margin-bottom:1em;"><%= t("support.home.categories.account.desc") %></p>
      </div>
      <p class="actions" style="margin-top:auto; padding-top:0.8em; text-align:right;">
        <%= link_to t("support.home.categories.account.link"), archive_faq_path("your-account") rescue link_to(t("support.home.categories.account.link"), archive_faqs_path) %>
      </p>
    </div>

    <!-- 2. Works -->
    <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box;">
      <div>
        <h4 class="heading" style="color:#900; margin-top:0;"><%= t("support.home.categories.works.title") %></h4>
        <p style="font-size:0.95em; color:#444; line-height:1.45; margin-bottom:1em;"><%= t("support.home.categories.works.desc") %></p>
      </div>
      <p class="actions" style="margin-top:auto; padding-top:0.8em; text-align:right;">
        <%= link_to t("support.home.categories.works.link"), archive_faq_path("posting-and-editing") rescue link_to(t("support.home.categories.works.link"), archive_faqs_path) %>
      </p>
    </div>

    <!-- 3. Tags -->
    <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box;">
      <div>
        <h4 class="heading" style="color:#900; margin-top:0;"><%= t("support.home.categories.tags.title") %></h4>
        <p style="font-size:0.95em; color:#444; line-height:1.45; margin-bottom:1em;"><%= t("support.home.categories.tags.desc") %></p>
      </div>
      <p class="actions" style="margin-top:auto; padding-top:0.8em; text-align:right;">
        <%= link_to t("support.home.categories.tags.link"), archive_faq_path("tags") rescue link_to(t("support.home.categories.tags.link"), archive_faqs_path) %>
      </p>
    </div>

    <!-- 4. Policy -->
    <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box;">
      <div>
        <h4 class="heading" style="color:#900; margin-top:0;"><%= t("support.home.categories.policy.title") %></h4>
        <p style="font-size:0.95em; color:#444; line-height:1.45; margin-bottom:1em;"><%= t("support.home.categories.policy.desc") %></p>
      </div>
      <p class="actions" style="margin-top:auto; padding-top:0.8em; text-align:right;">
        <%= link_to t("support.home.categories.policy.link"), tos_path rescue link_to(t("support.home.categories.policy.link"), archive_faqs_path) %>
      </p>
    </div>

    <!-- 5. FAQs -->
    <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box;">
      <div>
        <h4 class="heading" style="color:#900; margin-top:0;"><%= t("support.home.categories.faqs.title") %></h4>
        <p style="font-size:0.95em; color:#444; line-height:1.45; margin-bottom:1em;"><%= t("support.home.categories.faqs.desc") %></p>
      </div>
      <p class="actions" style="margin-top:auto; padding-top:0.8em; text-align:right;">
        <%= link_to t("support.home.categories.faqs.link"), archive_faqs_path %>
      </p>
    </div>

    <!-- 6. Direct Support -->
    <div class="module" style="background:#fdf8f8; border:1px solid #900; padding:1.2em; border-radius:4px; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box;">
      <div>
        <h4 class="heading" style="color:#900; margin-top:0;"><%= t("support.home.categories.custom.title") %></h4>
        <p style="font-size:0.95em; color:#444; line-height:1.45; margin-bottom:1em;"><%= t("support.home.categories.custom.desc") %></p>
      </div>
      <p class="actions" style="margin-top:auto; padding-top:0.8em; text-align:right;">
        <%= link_to t("support.home.categories.custom.link"), new_ticket_path, class: "button submit" %>
      </p>
    </div>
  </div>
</div>
