<% content_for :message do %>
  <p>Hello<%= " #{@feedback.username}" if @feedback.username.present? %>,</p>
  <p>We have received your support request: <strong>Ticket #<%= @feedback.id %></strong>.</p>
  <div style="background:#f9f9f9; border-left:4px solid #900; padding:12px; margin:16px 0;">
    <p><strong><%= strip_tags(@feedback.summary) %></strong></p>
    <%= raw sanitize_field(@feedback, :comment) %>
  </div>
  <p>Our support team will review your message and reply as soon as possible.</p>
  <p>You can check the status of your request and add more information at any time using the following link:</p>
  <p><a href="<%= @ticket_url %>"><%= @ticket_url %></a></p>
  <p>Best regards,<br><strong><%= ArchiveConfig.APP_NAME %> Support Team</strong></p>
<% end %>
<% content_for :sent_at do %>
  <%= l(Time.current) %>
<% end %>
