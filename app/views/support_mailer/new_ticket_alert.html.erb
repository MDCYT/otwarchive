<% content_for :message do %>
  <p>A new support request has been submitted:</p>
  <p><strong>Ticket #<%= @feedback.id %>:</strong> <%= strip_tags(@feedback.summary) %></p>
  <p><strong>Requester:</strong> <%= @feedback.username.presence || "Guest" %> &lt;<%= @feedback.email %>&gt;</p>
  <p><strong>Category:</strong> <%= @feedback.category.presence || "General" %></p>
  <p><strong>Language:</strong> <%= @feedback.language %></p>
  <div style="background:#f9f9f9; border-left:4px solid #333; padding:12px; margin:16px 0;">
    <%= raw sanitize_field(@feedback, :comment) %>
  </div>
  <p>To view and respond to this ticket, visit the support panel:</p>
  <p><a href="<%= @admin_url %>"><%= @admin_url %></a></p>
<% end %>
<% content_for :sent_at do %>
  <%= l(Time.current) %>
<% end %>
