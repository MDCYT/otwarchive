<% content_for :message do %>
  <p>Hola<%= " #{@feedback.username}" if @feedback.username.present? %>,</p>
  <p>El equipo de soporte ha respondido a tu solicitud <strong>[Ticket #<%= @feedback.id %>] <%= strip_tags(@feedback.summary) %></strong>:</p>
  <div style="background:#f9f9f9; border-left:4px solid #900; padding:12px; margin:16px 0;">
    <%= raw sanitize_field(@reply, :comment) %>
  </div>
  <p>Para ver el historial completo o enviar una respuesta, visita:</p>
  <p><a href="<%= @ticket_url %>"><%= @ticket_url %></a></p>
  <p>Atentamente,<br><strong><%= @reply.author_name %></strong><br>Equipo de Soporte de <%= ArchiveConfig.APP_NAME %></p>
<% end %>
<% content_for :sent_at do %>
  <%= l(Time.current) %>
<% end %>
