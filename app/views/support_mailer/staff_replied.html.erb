<% content_for :message do %>
  <p>Hello<%= " #{@feedback.username}" if @feedback.username.present? %>,</p>
  <p>A member of our support team has replied to your request (<strong>Ticket #<%= @feedback.id %>: <%= strip_tags(@feedback.summary) %></strong>):</p>
  <div style="background:#fdf9f9; border-left:4px solid #900; padding:14px; margin:16px 0;">
    <%= raw sanitize_field(@reply, :comment) %>
  </div>
  <p>To reply or view the entire conversation, please visit your ticket page:</p>
  <p><a href="<%= @ticket_url %>"><%= @ticket_url %></a></p>
  <p>Best regards,<br><strong><%= ArchiveConfig.APP_NAME %> Support Team</strong></p>
<% end %>
<% content_for :sent_at do %>
  <%= l(Time.current) %>
<% end %>
