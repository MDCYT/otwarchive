<% content_for :message do %>
  <p>The user has posted a reply on <strong>Ticket #<%= @feedback.id %>: <%= strip_tags(@feedback.summary) %></strong>:</p>
  <div style="background:#f9f9f9; border-left:4px solid #333; padding:12px; margin:16px 0;">
    <%= raw sanitize_field(@reply, :comment) %>
  </div>
  <p>View and manage this ticket in the support panel:</p>
  <p><a href="<%= @admin_url %>"><%= @admin_url %></a></p>
<% end %>
<% content_for :sent_at do %>
  <%= l(Time.current) %>
<% end %>
