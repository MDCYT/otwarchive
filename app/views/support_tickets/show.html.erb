<div class="support-ticket-thread wrapper" style="max-width:1050px; margin:0 auto; padding:0.5em 1em 2em; box-sizing:border-box;">
  <p class="navigation actions" style="margin-bottom:1.2em;">
    <%= link_to t("support_tickets.show.help_center"), support_root_path rescue link_to("Help Center", "/") %> &gt;
    <%= link_to t("support_tickets.show.back_to_list"), tickets_path %> &gt;
    Ticket #<%= @feedback.id %>
  </p>

  <h2 class="heading">
    [Ticket #<%= @feedback.id %>] <%= strip_tags(@feedback.summary) %>
  </h2>

  <div class="module" style="background:#fbfbfb; border:1px solid #ddd; padding:14px 18px; margin-bottom:1.5em; border-radius:4px; box-sizing:border-box;">
    <div style="display:flex; flex-wrap:wrap; gap:20px; align-items:center;">
      <div>
        <strong><%= t("support_tickets.show.status") %>:</strong>
        <% badge_color = case @feedback.status
           when 'open' then '#2e7d32'
           when 'pending' then '#e65100'
           when 'answered' then '#0d47a1'
           when 'closed' then '#616161'
           else '#2e7d32' end %>
        <span style="padding:2px 8px; border-radius:3px; background:<%= badge_color %>; color:#fff; font-size:0.85em; font-weight:bold;">
          <%= @feedback.status_label %>
        </span>
      </div>
      <div><strong><%= t("support_tickets.show.category") %>:</strong> <%= @feedback.category.presence || "General" %></div>
      <div><strong><%= t("support_tickets.show.created") %>:</strong> <%= l(@feedback.created_at, format: :short) rescue @feedback.created_at.to_s(:short) %></div>
      <div><strong><%= t("support_tickets.show.requester") %>:</strong> <%= @feedback.username.presence || @feedback.email %></div>
    </div>
  </div>

  <h3 class="landmark heading"><%= t("support_tickets.show.conversation") %></h3>
  <ol class="comment group" style="list-style:none; padding:0; margin:0 0 2em 0;">
    <!-- Original Request -->
    <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
      <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
        <strong><%= @feedback.username.presence || @feedback.email %></strong>
        <span style="color:#666; font-size:0.85em;">(<%= t("support_tickets.show.initial_request") %>)</span>
        <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(@feedback.created_at, format: :short) rescue @feedback.created_at.to_s(:short) %></span>
      </h4>
      <div class="userstuff" style="margin-top:10px;">
        <%= raw @feedback.comment %>
      </div>
    </li>

    <!-- Replies -->
    <% @replies.each do |reply| %>
      <% if reply.staff? %>
        <li class="comment group" style="background:#fdf9f9; border:1px solid #e0c8c8; border-left:5px solid #900; padding:15px; margin-bottom:15px; border-radius:4px;">
          <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #f0dede; padding-bottom:8px;">
            <span style="background:#900; color:#fff; padding:2px 7px; border-radius:3px; font-size:0.8em; font-weight:bold; margin-right:6px;"><%= t("support_tickets.show.staff_badge") %></span>
            <strong><%= reply.author_name %></strong>
            <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at, format: :short) rescue reply.created_at.to_s(:short) %></span>
          </h4>
          <div class="userstuff" style="margin-top:10px;">
            <%= raw sanitize_field(reply, :comment) %>
          </div>
        </li>
      <% else %>
        <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
          <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
            <strong><%= reply.author_name %></strong>
            <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at, format: :short) rescue reply.created_at.to_s(:short) %></span>
          </h4>
          <div class="userstuff" style="margin-top:10px;">
            <%= raw sanitize_field(reply, :comment) %>
          </div>
        </li>
      <% end %>
    <% end %>
  </ol>

  <!-- Reply Form -->
  <div class="module post comment" style="background:#fff; border:1px solid #ccc; padding:1.5em; border-radius:4px; box-sizing:border-box;">
    <h3 class="heading" style="margin-top:0;"><%= t("support_tickets.show.reply_legend") %></h3>
    
    <% if @feedback.closed? %>
      <p class="notice" style="margin-bottom:1em;"><%= t("support_tickets.show.resolved_note") %></p>
    <% end %>

    <%= form_for @reply, url: reply_ticket_path(@feedback) do |f| %>
      <p>
        <%= f.text_area :comment, rows: 6, cols: 60, placeholder: t("support_tickets.show.reply_placeholder"), required: true, style: "width:100%; box-sizing:border-box;" %>
      </p>
      <p class="submit actions" style="margin-top:1em; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <%= f.submit t("support_tickets.show.submit_reply"), class: "submit button" %>
        <% unless @feedback.closed? %>
          <%= link_to t("support_tickets.show.mark_resolved"), close_ticket_path(@feedback), method: :patch, data: { confirm: t("support_tickets.show.resolved_confirm") }, class: "button", style: "color:#666;" %>
        <% end %>
      </p>
    <% end %>
  </div>
</div>
