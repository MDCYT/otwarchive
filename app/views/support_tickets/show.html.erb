<div class="support-ticket-thread">
  <p class="navigation actions" style="margin-bottom:1em;">
    <%= link_to "Centro de Ayuda", root_path %> &gt;
    <%= link_to "Mis solicitudes", tickets_path %> &gt;
    Ticket #<%= @feedback.id %>
  </p>

  <h2 class="heading">
    [Ticket #<%= @feedback.id %>] <%= strip_tags(@feedback.summary) %>
  </h2>

  <div class="module" style="background:#fbfbfb; border:1px solid #ddd; padding:12px 16px; margin-bottom:1.5em; border-radius:4px;">
    <div style="display:flex; flex-wrap:wrap; gap:18px; align-items:center;">
      <div>
        <strong>Estado:</strong>
        <% badge_color = case @feedback.status
           when 'open' then '#2e7d32'
           when 'pending' then '#e65100'
           when 'answered' then '#0d47a1'
           when 'closed' then '#616161'
           else '#2e7d32' end %>
        <span style="padding:2px 8px; border-radius:3px; background:<%= badge_color %>; color:#fff; font-size:0.85em; font-weight:bold;">
          <%= @feedback.status_label %>
        </span>
      </div>
      <div><strong>Categoría:</strong> <%= @feedback.category.presence || "General" %></div>
      <div><strong>Fecha de envío:</strong> <%= l(@feedback.created_at) %></div>
      <div><strong>Solicitante:</strong> <%= @feedback.username.presence || @feedback.email %></div>
    </div>
  </div>

  <h3 class="landmark heading">Historial de la conversación</h3>
  <ol class="comment group" style="list-style:none; padding:0; margin:0 0 2em 0;">
    <!-- Mensaje original del usuario -->
    <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
      <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
        <strong><%= @feedback.username.presence || @feedback.email %></strong>
        <span style="color:#666; font-size:0.85em;">(Solicitud inicial)</span>
        <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(@feedback.created_at) %></span>
      </h4>
      <div class="userstuff" style="margin-top:10px;">
        <%= raw @feedback.comment %>
      </div>
    </li>

    <!-- Respuestas -->
    <% @replies.each do |reply| %>
      <% if reply.staff? %>
        <li class="comment group" style="background:#fdf9f9; border:1px solid #e0c8c8; border-left:5px solid #900; padding:15px; margin-bottom:15px; border-radius:4px;">
          <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #f0dede; padding-bottom:8px;">
            <span style="background:#900; color:#fff; padding:2px 7px; border-radius:3px; font-size:0.8em; font-weight:bold; margin-right:6px;">Equipo de Soporte de AO3</span>
            <strong><%= reply.author_name %></strong>
            <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at) %></span>
          </h4>
          <div class="userstuff" style="margin-top:10px;">
            <%= raw sanitize_field(reply, :comment) %>
          </div>
        </li>
      <% else %>
        <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
          <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
            <strong><%= reply.author_name %></strong>
            <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at) %></span>
          </h4>
          <div class="userstuff" style="margin-top:10px;">
            <%= raw sanitize_field(reply, :comment) %>
          </div>
        </li>
      <% end %>
    <% end %>
  </ol>

  <!-- Formulario de respuesta -->
  <div class="module post comment" style="background:#fff; border:1px solid #ccc; padding:1.5em; border-radius:4px;">
    <h3 class="heading" style="margin-top:0;">Añadir una respuesta a esta solicitud</h3>
    
    <% if @feedback.closed? %>
      <p class="notice" style="margin-bottom:1em;">Esta solicitud se encuentra actualmente resuelta. Si envías una respuesta, se reabrirá automáticamente para que el equipo la revise.</p>
    <% end %>

    <%= form_for @reply, url: reply_ticket_path(@feedback) do |f| %>
      <p>
        <%= f.text_area :comment, rows: 6, cols: 60, placeholder: "Escribe tu mensaje o aclaración adicional aquí...", required: true, style: "width:100%; box-sizing:border-box;" %>
      </p>
      <p class="submit actions" style="margin-top:1em; display:flex; gap:10px; align-items:center;">
        <%= f.submit "Enviar respuesta", class: "submit button" %>
        <% unless @feedback.closed? %>
          <%= link_to "Marcar solicitud como resuelta", close_ticket_path(@feedback), method: :patch, data: { confirm: "¿Confirmas que tu consulta ha quedado resuelta?" }, class: "button", style: "color:#666;" %>
        <% end %>
      </p>
    <% end %>
  </div>
</div>
