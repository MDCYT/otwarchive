<div class="admin wrapper" style="max-width:1150px; margin:0 auto; padding:0.5em 1em 2em; box-sizing:border-box;">
  <p class="navigation actions" style="margin-bottom:1.2em;">
    <%= link_to t("admin.support_tickets.show.back_to_panel", default: "&laquo; Back to Tickets Dashboard").html_safe, admin_support_tickets_path %>
  </p>

  <h2 class="heading">
    [Ticket #<%= @feedback.id %>] <%= strip_tags(@feedback.summary) %>
  </h2>

  <div style="display:flex; flex-wrap:wrap; gap:20px; margin-bottom:2em;">
    <!-- Left Column: Messages and Reply Form -->
    <div style="flex:2; min-width:320px;">
      <h3 class="heading"><%= t("admin.support_tickets.show.conversation", default: "Message History") %></h3>
      <ol class="comment group" style="list-style:none; padding:0; margin:0 0 2em 0;">
        <!-- Initial Message -->
        <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
          <% if @feedback.abuse? || @feedback.reported_url.present? %>
            <div style="background:#fff3f3; border:1px solid #f5c6cb; border-left:4px solid #900; padding:10px 14px; margin-bottom:15px; border-radius:3px;">
              <strong style="color:#900;">🛡️ <%= t("admin.support_tickets.show.abuse_alert", default: "Policy & Abuse Report") %></strong>
              <% if @feedback.reported_url.present? %>
                <div style="margin-top:6px; word-break:break-all;">
                  <strong><%= t("admin.support_tickets.show.reported_url", default: "Reported URL / Work") %>:</strong>
                  <%= link_to @feedback.reported_url, @feedback.reported_url, target: "_blank", rel: "noopener", style: "font-weight:bold; text-decoration:underline; color:#900;" %>
                  <span style="font-size:0.85em; color:#666;">(opens in new tab)</span>
                </div>
              <% end %>
            </div>
          <% end %>

          <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
            <strong><%= @feedback.username.presence || @feedback.email %></strong>
            <span style="color:#666; font-size:0.85em;">(<%= t("admin.support_tickets.show.initial_request", default: "Initial Request") %>)</span>
            <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(@feedback.created_at, format: :short) rescue @feedback.created_at.to_s(:short) %></span>
          </h4>
          <div class="userstuff" style="margin-top:10px;">
            <%= raw @feedback.comment %>
          </div>
        </li>

        <!-- Replies and Notes -->
        <% @replies.each do |reply| %>
          <% if reply.is_internal? %>
            <li class="comment group" style="background:#fffbe6; border:1px solid #ffe58f; border-left:5px solid #faad14; padding:15px; margin-bottom:15px; border-radius:4px;">
              <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #fff1b8; padding-bottom:8px;">
                <span style="background:#faad14; color:#fff; padding:2px 6px; border-radius:3px; font-size:0.8em; font-weight:bold;"><%= t("admin.support_tickets.show.internal_note_badge", default: "INTERNAL NOTE (Staff Only)") %></span>
                <strong><%= reply.author_name %></strong>
                <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at, format: :short) rescue reply.created_at.to_s(:short) %></span>
              </h4>
              <div class="userstuff" style="margin-top:10px;">
                <%= raw sanitize_field(reply, :comment) %>
              </div>
            </li>
          <% elsif reply.staff? %>
            <li class="comment group" style="background:#fdf9f9; border:1px solid #e0c8c8; border-left:5px solid #900; padding:15px; margin-bottom:15px; border-radius:4px;">
              <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #f0dede; padding-bottom:8px;">
                <span style="background:#900; color:#fff; padding:2px 7px; border-radius:3px; font-size:0.8em; font-weight:bold;"><%= t("admin.support_tickets.show.staff_response_badge", default: "Support Response") %></span>
                <strong><%= reply.author_name %></strong>
                <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at, format: :short) rescue reply.created_at.to_s(:short) %></span>
              </h4>
              <div class="userstuff" style="margin-top:10px;">
                <%= raw sanitize_field(reply, :comment) %>
              </div>
            </li>
          <% else %>
            <li class="comment group" style="background:#fff; border:1px solid #ddd; border-left:5px solid #4a729a; padding:15px; margin-bottom:15px; border-radius:4px;">
              <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
                <span style="background:#4a729a; color:#fff; padding:2px 6px; border-radius:3px; font-size:0.8em; font-weight:bold;">User Response</span>
                <strong><%= reply.author_name %></strong>
                <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at, format: :short) rescue reply.created_at.to_s(:short) %></span>
              </h4>
              <div class="userstuff" style="margin-top:10px;">
                <%= raw sanitize_field(reply, :comment) %>
              </div>
            </li>
          <% end %>
        <% end %>
      </ol>

      <!-- Reply Box -->
      <div class="module" style="background:#f9f9f9; border:1px solid #ddd; padding:20px; border-radius:4px;">
        <h3 class="heading" style="margin-top:0;"><%= t("admin.support_tickets.show.reply_heading", default: "Reply to Ticket") %></h3>
        <%= form_for @reply, url: reply_admin_support_ticket_path(@feedback), method: :post, html: {class: "post comment"} do |f| %>
          <div style="margin-bottom:15px;">
            <label style="display:inline-block; margin-right:20px; cursor:pointer;">
              <%= f.radio_button :is_internal, "0", checked: true, id: "reply_type_public" %>
              <strong><%= t("admin.support_tickets.show.reply_type_public", default: "Public response to user (will notify by email)") %></strong>
            </label>
            <br>
            <label style="display:inline-block; margin-top:5px; cursor:pointer; color:#b78103;">
              <%= f.radio_button :is_internal, "1", id: "reply_type_internal" %>
              <strong><%= t("admin.support_tickets.show.reply_type_internal", default: "Internal staff note (only visible to support/admin team)") %></strong>
            </label>
          </div>

          <p>
            <%= f.text_area :comment, rows: 8, cols: 60, required: true, style: "width:100%; box-sizing:border-box; margin-bottom:15px;" %>
          </p>

          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <label for="next_status"><strong><%= t("admin.support_tickets.show.next_status", default: "Set status to:") %></strong></label>
              <%= select_tag :next_status, options_for_select([
                [t("support_tickets.statuses.answered", default: "Answered"), "answered"],
                [t("support_tickets.statuses.pending", default: "Pending"), "pending"],
                [t("support_tickets.statuses.closed", default: "Resolved"), "closed"],
                [t("support_tickets.statuses.open", default: "Open"), "open"]
              ], "answered") %>
            </div>
            <div>
              <%= f.submit t("admin.support_tickets.show.send_reply", default: "Submit Response") %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Sidebar metadata & actions -->
    <div style="flex:1; min-width:280px;">
      <div class="module" style="background:#fff; border:1px solid #ddd; padding:15px; border-radius:4px; margin-bottom:20px;">
        <h4 class="heading" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:6px;"><%= t("admin.support_tickets.show.requester_info", default: "Requester Info") %></h4>
        <p style="margin:6px 0;">
          <strong><%= t("admin.support_tickets.show.user_account", default: "AO3 Account:") %></strong>
          <% if @user %>
            <%= link_to @user.login, admin_users_path(query: @user.login) %>
          <% elsif @feedback.username.present? %>
            <%= @feedback.username %> (<span style="color:#888;"><%= t("admin.support_tickets.show.guest", default: "Guest") %></span>)
          <% else %>
            <span style="color:#888;"><%= t("admin.support_tickets.show.guest", default: "Guest") %></span>
          <% end %>
        </p>
        <p style="margin:6px 0;">
          <strong><%= t("admin.support_tickets.show.email", default: "Email:") %></strong>
          <a href="mailto:<%= @feedback.email %>"><%= @feedback.email %></a>
        </p>
        <p style="margin:6px 0;">
          <strong><%= t("admin.support_tickets.show.type", default: "Ticket Type:") %></strong>
          <% if @feedback.abuse? %>
            <span style="background:#900; color:#fff; font-size:0.8em; padding:2px 6px; border-radius:3px; font-weight:bold;">🛡️ Policy & Abuse</span>
          <% else %>
            <span style="background:#0277bd; color:#fff; font-size:0.8em; padding:2px 6px; border-radius:3px; font-weight:bold;">🛠️ Technical Support</span>
          <% end %>
        </p>
        <p style="margin:6px 0;">
          <strong><%= t("admin.support_tickets.show.category", default: "Category:") %></strong> <%= @feedback.category.presence || "General" %>
        </p>
        <p style="margin:6px 0;">
          <strong><%= t("admin.support_tickets.show.language", default: "Language:") %></strong> <%= @feedback.language.presence || "English" %>
        </p>
        <p style="margin:6px 0;">
          <strong><%= t("admin.support_tickets.show.created_at", default: "Created:") %></strong> <%= l(@feedback.created_at, format: :short) rescue @feedback.created_at.to_s(:short) %>
        </p>
        <% if @feedback.ip_address.present? %>
          <p style="margin:6px 0;">
            <strong><%= t("admin.support_tickets.show.ip", default: "IP Address:") %></strong> <%= @feedback.ip_address %>
          </p>
        <% end %>
        <% if @feedback.user_agent.present? %>
          <p style="margin:6px 0; font-size:0.85em; color:#666; word-break:break-all;">
            <strong><%= t("admin.support_tickets.show.user_agent", default: "User Agent:") %></strong> <%= @feedback.user_agent %>
          </p>
        <% end %>
      </div>

      <div class="module" style="background:#fff; border:1px solid #ddd; padding:15px; border-radius:4px; margin-bottom:20px;">
        <h4 class="heading" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:6px;"><%= t("admin.support_tickets.show.admin_management", default: "Status & Assignment") %></h4>

        <!-- Status update form -->
        <%= form_tag update_status_admin_support_ticket_path(@feedback), method: :patch, style: "margin-bottom:15px;" do %>
          <p style="margin:6px 0;">
            <label for="status"><strong><%= t("admin.support_tickets.show.status_label", default: "Current Status:") %></strong></label><br>
            <%= select_tag :status, options_for_select([
              [t("support_tickets.statuses.open", default: "Open"), "open"],
              [t("support_tickets.statuses.pending", default: "Pending"), "pending"],
              [t("support_tickets.statuses.answered", default: "Answered"), "answered"],
              [t("support_tickets.statuses.closed", default: "Resolved"), "closed"]
            ], @feedback.status), style: "margin-top:4px;" %>
            <%= submit_tag t("admin.support_tickets.show.save_status", default: "Update"), style: "margin-left:5px;" %>
          </p>
        <% end %>

        <!-- Assignment form -->
        <%= form_tag assign_admin_support_ticket_path(@feedback), method: :patch do %>
          <p style="margin:6px 0;">
            <label for="admin_id"><strong><%= t("admin.support_tickets.show.assigned_label", default: "Assigned To:") %></strong></label><br>
            <%= select_tag :admin_id, options_for_select(
              [[t("admin.support_tickets.show.unassigned", default: "Unassigned"), "unassign"]] + @admins.map { |a| [a.login, a.id] },
              @feedback.assigned_to_id
            ), style: "margin-top:4px;" %>
            <%= submit_tag t("admin.support_tickets.show.assign_button", default: "Assign"), style: "margin-left:5px;" %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
