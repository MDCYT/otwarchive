<div class="admin">
  <p class="navigation actions" style="margin-bottom:1em;">
    <%= link_to "&laquo; Volver al listado de tickets".html_safe, admin_support_tickets_path %>
  </p>

  <h2 class="heading">
    [Ticket #<%= @feedback.id %>] <%= strip_tags(@feedback.summary) %>
  </h2>

  <div style="display:flex; flex-wrap:wrap; gap:20px; margin-bottom:2em;">
    <!-- Columna Izquierda: Conversación y Respuestas -->
    <div style="flex:2; min-width:320px;">
      <h3 class="heading">Historial de mensajes</h3>
      <ol class="comment group" style="list-style:none; padding:0; margin:0 0 2em 0;">
        <!-- Mensaje original -->
        <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
          <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
            <strong><%= @feedback.username.presence || @feedback.email %></strong>
            <span style="color:#666; font-size:0.85em;">(Solicitud inicial)</span>
            <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(@feedback.created_at) %></span>
          </h4>
          <div class="userstuff" style="margin-top:10px;">
            <%= raw @feedback.comment %>
          </div>
        </li>

        <!-- Respuestas y Notas -->
        <% @replies.each do |reply| %>
          <% if reply.is_internal? %>
            <li class="comment group" style="background:#fffbe6; border:1px solid #ffe58f; border-left:5px solid #faad14; padding:15px; margin-bottom:15px; border-radius:4px;">
              <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #fff1b8; padding-bottom:8px;">
                <span style="background:#faad14; color:#fff; padding:2px 6px; border-radius:3px; font-size:0.8em; font-weight:bold;">NOTA INTERNA (Solo Equipo)</span>
                <strong><%= reply.author_name %></strong>
                <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at) %></span>
              </h4>
              <div class="userstuff" style="margin-top:10px;">
                <%= raw sanitize_field(reply, :comment) %>
              </div>
            </li>
          <% elsif reply.staff? %>
            <li class="comment group" style="background:#fdf9f9; border:1px solid #e0c8c8; border-left:5px solid #900; padding:15px; margin-bottom:15px; border-radius:4px;">
              <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #f0dede; padding-bottom:8px;">
                <span style="background:#900; color:#fff; padding:2px 7px; border-radius:3px; font-size:0.8em; font-weight:bold;">Respuesta de Soporte</span>
                <strong><%= reply.author_name %></strong>
                <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at) %></span>
              </h4>
              <div class="userstuff" style="margin-top:10px;">
                <%= raw sanitize_field(reply, :comment) %>
              </div>
            </li>
          <% else %>
            <li class="comment group" style="background:#fff; border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:4px;">
              <h4 class="heading byline" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:8px;">
                <strong><%= reply.author_name %></strong>
                <span class="posted datetime" style="float:right; font-size:0.85em; color:#777;"><%= l(reply.created_at) %></span>
              </h4>
              <div class="userstuff" style="margin-top:10px;">
                <%= raw sanitize_field(reply, :comment) %>
              </div>
            </li>
          <% end %>
        <% end %>
      </ol>

      <!-- Formulario de Respuesta para Soporte -->
      <div class="module post comment" style="background:#fff; border:1px solid #ccc; padding:1.5em; border-radius:4px;">
        <h3 class="heading" style="margin-top:0;">Responder al Ticket</h3>

        <%= form_for @reply, url: reply_admin_support_ticket_path(@feedback) do |f| %>
          <div style="margin-bottom:1em; background:#f9f9f9; padding:8px 12px; border:1px solid #e5e5e5; border-radius:3px;">
            <label style="margin-right:20px; font-weight:normal;">
              <%= f.radio_button :is_internal, "0", checked: true %>
              <strong>Respuesta pública al usuario</strong> (se notificará por correo electrónico)
            </label>
            <label style="font-weight:normal;">
              <%= f.radio_button :is_internal, "1" %>
              <strong style="color:#b78103;">Nota interna</strong> (solo visible para administradores)
            </label>
          </div>

          <p>
            <%= f.text_area :comment, rows: 8, cols: 60, placeholder: "Escribe tu respuesta aquí...", required: true, style: "width:100%; box-sizing:border-box;" %>
          </p>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1em; flex-wrap:wrap; gap:10px;">
            <div>
              <label for="next_status" style="margin-right:6px;">Cambiar estado a:</label>
              <%= select_tag :next_status, options_for_select([
                ["Respondido", "answered"],
                ["En espera del usuario", "pending"],
                ["Resuelto / Cerrado", "closed"],
                ["Abierto", "open"]
              ], "answered") %>
            </div>
            <%= f.submit "Enviar respuesta", class: "submit button" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Columna Derecha: Metadatos y Asignación -->
    <div style="flex:1; min-width:260px;">
      <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px; margin-bottom:1.5em;">
        <h4 class="heading" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:6px;">Estado y Asignación</h4>

        <!-- Formulario Estado -->
        <%= form_tag update_status_admin_support_ticket_path(@feedback), method: :patch, style: "margin-bottom:1.2em;" do %>
          <p style="margin-bottom:4px;"><strong>Estado actual:</strong></p>
          <div style="display:flex; gap:6px;">
            <%= select_tag :status, options_for_select([
              ["Abierto", "open"],
              ["En espera", "pending"],
              ["Respondido", "answered"],
              ["Resuelto / Cerrado", "closed"]
            ], @feedback.status), style: "flex:1;" %>
            <%= submit_tag "Guardar", class: "button" %>
          </div>
        <% end %>

        <!-- Formulario Asignar -->
        <%= form_tag assign_admin_support_ticket_path(@feedback), method: :patch do %>
          <p style="margin-bottom:4px;"><strong>Asignado a:</strong></p>
          <div style="display:flex; gap:6px;">
            <%= select_tag :admin_id, options_from_collection_for_select(@admins, :id, :login, @feedback.assigned_to_id), prompt: "Sin asignar", style: "flex:1;" %>
            <%= submit_tag "Asignar", class: "button" %>
          </div>
        <% end %>
      </div>

      <div class="module" style="background:#fff; border:1px solid #ccc; padding:1.2em; border-radius:4px;">
        <h4 class="heading" style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:6px;">Detalles del Solicitante</h4>
        <dl style="margin:0;">
          <dt><strong>Usuario:</strong></dt>
          <dd style="margin-bottom:8px;">
            <% if @user %>
              <%= link_to @user.login, user_path(@user) %>
            <% elsif @feedback.username.present? %>
              <%= @feedback.username %> (no vinculado)
            <% else %>
              <span style="color:#888;">No especificado</span>
            <% end %>
          </dd>

          <dt><strong>Correo electrónico:</strong></dt>
          <dd style="margin-bottom:8px;">
            <a href="mailto:<%= @feedback.email %>"><%= @feedback.email %></a>
          </dd>

          <dt><strong>Categoría:</strong></dt>
          <dd style="margin-bottom:8px;"><%= @feedback.category.presence || "General" %></dd>

          <dt><strong>Idioma:</strong></dt>
          <dd style="margin-bottom:8px;"><%= @feedback.language %></dd>

          <dt><strong>Fecha creación:</strong></dt>
          <dd style="margin-bottom:8px;"><%= l(@feedback.created_at) %></dd>

          <dt><strong>IP del usuario:</strong></dt>
          <dd style="margin-bottom:8px;"><code><%= @feedback.ip_address.presence || "No registrada" %></code></dd>

          <dt><strong>User-Agent:</strong></dt>
          <dd style="margin-bottom:8px; word-break:break-all; font-size:0.85em; color:#555;">
            <%= @feedback.user_agent.presence || "No registrado" %>
          </dd>
        </dl>
      </div>
    </div>
  </div>
</div>
