<div class="admin wrapper" style="max-width:1150px; margin:0 auto; padding:0.5em 1em 2em; box-sizing:border-box;">
  <h2 class="heading"><%= t("admin.support_tickets.index.page_title") %></h2>

  <ul class="navigation actions" role="navigation" style="margin-bottom:1.5em;">
    <li><%= span_if_current t("admin.support_tickets.index.filter_all", count: @counts[:all]), admin_support_tickets_path %></li>
    <li><%= span_if_current t("admin.support_tickets.index.filter_open", count: @counts[:open]), admin_support_tickets_path(status: 'open') %></li>
    <li><%= span_if_current t("admin.support_tickets.index.filter_pending", count: @counts[:pending]), admin_support_tickets_path(status: 'pending') %></li>
    <li><%= span_if_current t("admin.support_tickets.index.filter_answered", count: @counts[:answered]), admin_support_tickets_path(status: 'answered') %></li>
    <li><%= span_if_current t("admin.support_tickets.index.filter_closed", count: @counts[:closed]), admin_support_tickets_path(status: 'closed') %></li>
  </ul>

  <% if @tickets.any? %>
    <div class="wrapper">
      <table summary="List of user support tickets for administration and support staff">
        <caption><%= t("admin.support_tickets.index.caption", filter: @status_filter.capitalize) %></caption>
        <thead>
          <tr>
            <th scope="col" style="width:60px;"><%= t("admin.support_tickets.index.id") %></th>
            <th scope="col" style="width:180px;"><%= t("admin.support_tickets.index.requester") %></th>
            <th scope="col"><%= t("admin.support_tickets.index.subject") %></th>
            <th scope="col" style="width:140px;"><%= t("admin.support_tickets.index.category") %></th>
            <th scope="col" style="width:110px;"><%= t("admin.support_tickets.index.status") %></th>
            <th scope="col" style="width:130px;"><%= t("admin.support_tickets.index.assigned_to") %></th>
            <th scope="col" style="width:120px;"><%= t("admin.support_tickets.index.date") %></th>
            <th scope="col" style="width:90px;"><%= t("admin.support_tickets.index.action") %></th>
          </tr>
        </thead>
        <tbody>
          <% @tickets.each do |ticket| %>
            <tr>
              <td><strong>#<%= ticket.id %></strong></td>
              <td>
                <% if ticket.username.present? %>
                  <%= link_to ticket.username, user_path(ticket.username) rescue ticket.username %><br>
                <% end %>
                <small style="color:#666;"><%= ticket.email %></small>
              </td>
              <td>
                <%= link_to strip_tags(ticket.summary), admin_support_ticket_path(ticket), style: "font-weight:bold;" %>
              </td>
              <td><%= ticket.category.presence || "General" %></td>
              <td>
                <% badge_color = case ticket.status
                   when 'open' then '#2e7d32'
                   when 'pending' then '#e65100'
                   when 'answered' then '#0d47a1'
                   when 'closed' then '#616161'
                   else '#2e7d32' end %>
                <span style="display:inline-block; padding:2px 7px; border-radius:3px; background:<%= badge_color %>; color:#fff; font-size:0.85em; font-weight:bold;">
                  <%= ticket.status_label %>
                </span>
              </td>
              <td>
                <%= ticket.assigned_to&.login || content_tag(:span, t("admin.support_tickets.index.unassigned"), style: "color:#888; font-style:italic;") %>
              </td>
              <td><%= l(ticket.created_at, format: :short) rescue ticket.created_at.to_s(:short) %></td>
              <td>
                <%= link_to t("admin.support_tickets.index.action"), admin_support_ticket_path(ticket), class: "actions" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= will_paginate @tickets %>
  <% else %>
    <p class="notice" style="margin-top:1.5em;"><%= t("admin.support_tickets.index.no_tickets") %></p>
  <% end %>
</div>
